@startuml
skinparam classAttributeIconSize 0
skinparam backgroundColor white
skinparam classBackgroundColor #FEFECE
skinparam classBorderColor #A80036
skinparam arrowColor #A80036

title UML Class Diagram: Architecture

package "Edge Device (Local)" {
    class VibrationSensor {
        - mean : float
        - std_dev : float
        - anomaly_rate : float
        - mode : OperationMode
        + generate_reading() : dict
        + publish_to_pubsub(data) : void
        + run_local_inference(data) : Result
    }
    
    class PubSubClient {
        - publisher : SensorPublisher
        - subscriber : AnomalySubscriber
        + publish_batch(readings[]) : void
        + subscribe_results(callback) : void
    }
    
    VibrationSensor --> PubSubClient : uses (PERFORMANCE mode)
}

package "Light Model Service (Local)" {
    class LightModelAPI {
        - light_model : IsolationForest (n=10)
        + /predict : POST
        + /health : GET
        - load_model() : void
    }
    
    class IsolationForestLight {
        - n_estimators : 10
        - contamination : 0.003
        + fit(X) : void
        + predict(X) : array
    }
    
    LightModelAPI --> IsolationForestLight : uses
}

VibrationSensor ..> LightModelAPI : REST API (ECO mode)

package "Google Cloud Platform" {
    
    class "Cloud Pub/Sub" as PubSub {
        + sensor-data topic
        + anomaly-results topic
    }

    class HeavyModelService {
        - heavy_model : IsolationForest (n=200)
        + on_sensor_data(batch) : void
        - process_batch(readings[]) : Result[]
        - publish_results(results) : void
    }
    
    class IsolationForestHeavy {
        - n_estimators : 200
        - contamination : 0.003
        + fit(X) : void
        + predict(X) : array
    }
    
    class AnomalyMonitor {
        + log_anomaly(data) : void
        + export_metrics() : void
    }
    
    HeavyModelService --> IsolationForestHeavy : uses
    HeavyModelService --> AnomalyMonitor : logs to
}

' Relationships
PubSubClient ..> PubSub : Publishes sensor data batches
PubSubClient <.. PubSub : Subscribes to anomaly results

HeavyModelService <.. PubSub : Subscribes to sensor-data
HeavyModelService ..> PubSub : Publishes anomaly results

@enduml