@startuml
autonumber
skinparam backgroundColor white
skinparam participantBackgroundColor #FEFECE
skinparam participantBorderColor #A80036
skinparam arrowColor #A80036

title Carbon-Aware IoT Anomaly Detection System - Sequence Diagram

actor "User/GUI" as User
participant "VibrationSensor\n(Edge)" as Sensor
participant "SensorPublisher\n(Edge)" as Publisher
queue "Pub/Sub\n(sensor-data)" as SensorTopic
participant "HeavyModelService\n(Cloud Run)" as HeavyAPI
queue "Pub/Sub\n(anomaly-results)" as ResultTopic
participant "AnomalySubscriber\n(Edge)" as Subscriber
participant "LightModelAPI\n(localhost:5001)" as LightAPI
participant "CloudMonitoring" as Monitor

== Initialization ==
User -> Sensor : Start Application
Sensor -> Publisher : Initialize Pub/Sub Publisher
Sensor -> Subscriber : Initialize Pub/Sub Subscriber
Subscriber -> Subscriber : Start Listening Thread
Sensor -> LightAPI : Configure ML API URL

== Scenario A: PERFORMANCE Mode (Low Carbon Intensity) ==
User -> Sensor : Switch to PERFORMANCE Mode
note right of Sensor
  Mode: Stream to cloud
  Batch size: 10 readings
  Heavy model: 200 estimators
end note

loop Every 100ms
    Sensor -> Sensor : Generate Reading
    Sensor -> Publisher : Add Reading to Batch
    
    alt Batch Full (10 readings)
        Publisher -> SensorTopic : Publish Batch\n{"device_id", "readings"[10]}
        SensorTopic -> HeavyAPI : Trigger Subscription
        activate HeavyAPI
        
        loop For Each Reading in Batch
            HeavyAPI -> HeavyAPI : Heavy Model Inference\n(200 estimators)
        end
        
        HeavyAPI -> ResultTopic : Publish Results\n{"device_id", "readings", "predictions"}
        HeavyAPI -> Monitor : Log Anomalies to\nCloud Logging/Monitoring
        deactivate HeavyAPI
        
        ResultTopic -> Subscriber : Callback: on_anomaly_results()
        Subscriber -> Sensor : Update cloud_anomalies_detected
        Sensor -> User : Display Anomaly (if detected)
    end
end

== Scenario B: ECO Mode (High Carbon Intensity) ==
User -> Sensor : Switch to ECO Mode
note right of Sensor
  Mode: Local processing
  Latency: <50ms
  Light model: 10 estimators
end note

loop Every 100ms
    Sensor -> Sensor : Generate Reading
    Sensor -> LightAPI : POST /predict\n{"value": vibration}
    activate LightAPI
    LightAPI -> LightAPI : Light Model Inference\n(10 estimators)
    LightAPI -> Sensor : Response\n{"is_anomaly", "confidence"}
    deactivate LightAPI
    
    alt Anomaly Detected
        Sensor -> Sensor : Increment api_anomalies_detected
        Sensor -> User : Display Anomaly
    end
end

== Statistics & Monitoring ==
User -> Sensor : Request Statistics
Sensor -> User : Return Stats\n(total_readings, anomalies,\nmode-specific detections)

@enduml