@startuml
skinparam backgroundColor white
skinparam ActivityBackgroundColor #FEFECE
skinparam ActivityBorderColor #A80036
skinparam ActivityFontSize 14
skinparam ArrowColor #A80036

title CI/CD Pipeline

' Define Swimlanes
|#Pink|Developer (Local Machine)|
|#LightBlue|GitHub Actions (CI Runner)|
|#LightGreen|Google Cloud Platform (CD Target)|

|Developer (Local Machine)|
start
:Create/Work on **Feature Branch**;
:Write Code & Local Tests;
:Commit & Push to GitHub;

|GitHub Actions (CI Runner)|
:Trigger Workflow;

partition "Continuous Integration (All Branches)" {
    note right
        Runs on EVERY push
        (Feature & Main)
    end note
    
    fork
        :Job: Unit Testing;
        :Install Dependencies;
        :Run pytest suite;
    fork again
        :Job: Code Quality;
        :Run Linter (flake8);
        :Check Formatting;
    end fork
    
    :Job: Build Test (Dry Run);
    note right
        Executes 'docker build' to verify
        Dockerfile validity, but does
        **NOT** push to registry.
    end note
    
    if (CI Jobs Successful?) then (No)
        :Mark Commit Failed;
        :Block Merge Request;
        stop
    else (Yes)
    endif
}

' The Decision Point
if (Branch is 'main'?) then (No)
    :Mark Checks Passed;
    :Ready for Merge;
    note right
        Stop here for
        Feature Branches
    end note
    stop
else (Yes)
    note right
        Proceed only if code
        was pushed/merged to Main
    end note
endif

partition "Continuous Delivery (Main Only)" {
    :Authenticate to Google Cloud;
    
    fork
        :Build "Carbon Controller" Image;
        :Push to Artifact Registry;
    fork again
        :Build "Cloud Processor" Image;
        :Push to Artifact Registry;
    fork again
        :Build "Smart Edge" Image;
        :Push to Artifact Registry;
    end fork

    :Deploy Services to **Cloud Run**;
    note right
        Deploys:
        1. Carbon Controller
        2. Cloud Processor
        3. Anomaly Logger
    end note
}

|Google Cloud Platform (CD Target)|
:Spin up new Containers;
:Route Traffic to New Revision;

stop

@enduml