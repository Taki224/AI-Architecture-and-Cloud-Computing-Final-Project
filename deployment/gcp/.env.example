# GCP Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Your GCP Project ID
GOOGLE_CLOUD_PROJECT=your-project-id

# Pub/Sub Topics
PUBSUB_SENSOR_TOPIC=sensor-data
PUBSUB_ANOMALY_TOPIC=anomaly-results

# Pub/Sub Subscriptions
PUBSUB_SENSOR_SUBSCRIPTION=sensor-data-sub
PUBSUB_ANOMALY_SUBSCRIPTION=anomaly-results-sub

# Device Configuration (for edge device)
DEVICE_ID=edge-001

# ML API URL (for ECO mode REST calls)
ML_API_URL=http://localhost:5001

# Heavy Model Service Port (Cloud Run default)
PORT=8080

# Model Paths (inside containers)
HEAVY_MODEL_PATH=/app/models/model_heavy.pkl
LIGHT_MODEL_PATH=/app/models/model_light.pkl

# For local development with Pub/Sub emulator
# Uncomment and set when running outside docker-compose
# PUBSUB_EMULATOR_HOST=localhost:8085

# For local development with real GCP (alternative to emulator)
# Set path to service account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
