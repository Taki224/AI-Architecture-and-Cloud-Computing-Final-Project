# Dockerfile for Heavy Model Service (Cloud Run / GCP)
# Subscribes to Pub/Sub for sensor data, runs heavy model inference,
# publishes results back to Pub/Sub

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY services/heavy-model/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Copy the heavy model service code
COPY services/heavy-model/ /app/

# Copy shared model code
COPY models/hybrid_detector.py /app/models/
COPY models/isolation_forest_detector.py /app/models/
COPY models/statistical_model.py /app/models/

# Copy pre-trained model
COPY models/model_heavy.pkl /app/models/

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV HEAVY_MODEL_PATH=/app/models/model_heavy.pkl

# Expose Cloud Run default port
EXPOSE 8080

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Run the API service
CMD ["python", "api_service.py"]
